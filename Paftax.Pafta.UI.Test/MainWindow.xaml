<Window x:Class="Paftax.Pafta.UI.Test.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Paftax.Pafta.UI.Test"
        xmlns:controls="clr-namespace:Paftax.Pafta.UI.Controls;assembly=Paftax.Pafta.UI"
        xmlns:views="clr-namespace:Paftax.Pafta.UI.Views;assembly=Paftax.Pafta.UI"
        xmlns:converters="clr-namespace:Paftax.Pafta.UI.Test.Converters"
        xmlns:drawing="clr-namespace:Paftax.Pafta.Drawing;assembly=Paftax.Pafta.Drawing"
        xmlns:vm="clr-namespace:Paftax.Pafta.UI.ViewModels;assembly=Paftax.Pafta.UI"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="MainWindow" Height="1000" Width="1200">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Paftax.Pafta.UI;component/Resources/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    <Grid Background="{DynamicResource WindowBackground}">
        <views:GraphicDesignerUserControl HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10"/>
    </Grid>
</Window>
