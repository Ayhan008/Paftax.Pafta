<Window x:Class="Paftax.Pafta.UI.Test.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Paftax.Pafta.UI.Test"
        xmlns:drawing="clr-namespace:Paftax.Pafta.Drawing;assembly=Paftax.Pafta.Drawing"
        xmlns:controls="clr-namespace:Paftax.Pafta.UI.Controls;assembly=Paftax.Pafta.UI"
        xmlns:converters="clr-namespace:Paftax.Pafta.UI.Test.Converters"
        xmlns:vm="clr-namespace:Paftax.Pafta.UI.Test.ViewModels" d:DataContext="{d:DesignInstance Type=vm:ProgressRingDemoViewModel}"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="MainWindow" Height="450" Width="800">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Paftax.Pafta.UI;component/Resources/Themes/Dark.xaml"/>
                <ResourceDictionary Source="/Paftax.Pafta.UI;component/Resources/Styles/ProgressRingStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="White" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Indeterminate toggle -->
        <CheckBox Content="Indeterminate" IsChecked="{Binding IsIndeterminate, Mode=TwoWay}" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- ProgressRing -->
        <controls:ProgressRing Grid.Row="1"
                               Width="120" Height="120"
                               StrokeThickness="8"
                               Speed="5"
                               Foreground="OrangeRed"
                               Background="Black"
                               Value="{Binding Value}"
                               Maximum="100"
                               IsIndeterminate="{Binding IsIndeterminate}"/>

        <!-- Slider -->
        <Slider Grid.Row="2"
                Minimum="0" Maximum="100"
                Value="{Binding Value, Mode=TwoWay}"
                Width="250" 
                Margin="0,0,0,0"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                IsEnabled="{Binding IsIndeterminate, Converter={StaticResource InverseBooleanConverter}}"/>

        <ComboBox HorizontalAlignment="Left" Margin="-212,32,0,0" VerticalAlignment="Top" Width="120" Grid.Row="1" SelectedIndex="0">
            <ComboBoxItem Tag="A" Height="30" Content="A"/>
            <ComboBoxItem Tag="B" Height="30" Content="B"/>
        </ComboBox>
    </Grid>
</Window>
