<UserControl x:Class="Paftax.Pafta.UI.Views.InfoDialogUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Paftax.Pafta.UI.Views"
             xmlns:properties="clr-namespace:Paftax.Pafta.UI.AttachedProperties" properties:ThemeChanged.EnableTheme="True"           
             xmlns:vm="clr-namespace:Paftax.Pafta.UI.ViewModels" 
             xmlns:controls="clr-namespace:Paftax.Pafta.UI.Controls" 
             d:DataContext="{d:DesignInstance Type=vm:InfoDialogViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="250" d:DesignWidth="400">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Paftax.Pafta.UI;component/Resources/Themes/Dark.xaml"/>
                <ResourceDictionary Source="/Paftax.Pafta.UI;component/Resources/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="75"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <controls:FontIcon x:Name="InfoIcon"
                               Grid.Column="0"
                               Margin="10"
                               Width="50"
                               Glyph="{Binding Glyph}"
                               Height="50"
                               VerticalAlignment="Top"
                               HorizontalAlignment="Center"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="50"
                               Foreground="{DynamicResource FontIconForeground}"/>

            <TextBlock x:Name="InfoTextBlock"
                       Grid.Column="1"
                       Margin="0,15,10,10"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Stretch"
                       FontFamily="{StaticResource PrimaryFont}"
                       FontWeight="{StaticResource FontWeightNormal}"
                       FontSize="{StaticResource FontSizeLarge}"
                       Text="{Binding Message}"
                       HorizontalAlignment="Stretch"/>
        </Grid>

        <Border Grid.Row="0" 
                HorizontalAlignment="Stretch" 
                Height="1"
                VerticalAlignment="Top"/>

        <Border Grid.Row="0" 
                HorizontalAlignment="Stretch" 
                Height="1"
                VerticalAlignment="Bottom"/>

        <Border Grid.Row="1" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch"
                Background="{DynamicResource DataGridColumnHeaderBackground}"
                CornerRadius="0,0, 9.6, 9.6">

            <Button x:Name="OkButton" 
                    Background="{DynamicResource DataGridColumnHeaderBackground}"
                    Grid.Row="2"
                    Content="OK"
                    Width="80"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,10,10,0"
                    Command="{Binding OkCommand}"/>
        </Border>

    </Grid>
</UserControl>
