<Window x:Class="Paftax.Pafta.UI.Views.CleanProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:Paftax.Pafta.UI.ViewModels"
        xmlns:behaviors="clr-namespace:Paftax.Pafta.UI.Behaviors"
        xmlns:controls="clr-namespace:Paftax.Pafta.UI.Controls"
        xmlns:local="clr-namespace:Paftax.Pafta.UI.Views"
        mc:Ignorable="d"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        Title="Clean Project" Height="700" Width="500">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Paftax.Pafta.UI;component/Resources/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>


    <Border BorderBrush="{DynamicResource WindowBorderBrush}" 
            Background="{DynamicResource WindowBackground}" 
            BorderThickness="1"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect Color="Black"
                              BlurRadius="50"   
                              ShadowDepth="0"
                              Opacity="0.3"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="45"/>
            </Grid.RowDefinitions>

            <controls:TitleBar Grid.Row="0"/>

            <Border Grid.Row="1" 
                    HorizontalAlignment="Stretch" 
                    Height="1"
                    VerticalAlignment="Top"/>

            <TabControl Grid.Row="1" 
                        Margin="10" 
                        SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

                <TabItem Header="Views">
                    <local:FilterableElementSelectionUserControl DataContext="{Binding FilterableViewsViewModel}"/>
                </TabItem>

                <TabItem Header="View Templates">
                    <local:FilterableElementSelectionUserControl DataContext="{Binding FilterableViewTemplatesViewModel}"/>
                </TabItem>

                <TabItem Header="Filters">
                    <local:FilterableElementSelectionUserControl DataContext="{Binding FilterableParameterFiltersViewModel}"/>
                </TabItem>

                <TabItem Header="Materials">
                    <local:FilterableElementSelectionUserControl DataContext="{Binding FilterableMaterialsViewModel}"/>
                </TabItem>

                <TabItem Header="Lines">
                    <local:FilterableElementSelectionUserControl DataContext="{Binding FilterableLinesViewModel}"/>
                </TabItem>
            </TabControl>
            
            <Border Grid.Row="1" 
                    HorizontalAlignment="Stretch" 
                    Height="1"
                    VerticalAlignment="Bottom"/>

            <StackPanel Orientation="Horizontal" 
                        Margin="0,0,10,0"
                        Grid.Row="2" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center">

                <Button x:Name="CleanButton" Content="Clean" 
                        HorizontalAlignment="Right" 
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource ResultButtonStyle}"
                        Command="{Binding CleanCommand}"/>

                <Button x:Name="CancelButton" Content="Cancel" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center"
                        Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
