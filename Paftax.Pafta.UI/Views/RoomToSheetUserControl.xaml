<UserControl x:Class="Paftax.Pafta.UI.Views.RoomToSheetUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Paftax.Pafta.UI.Views"
             xmlns:controls="clr-namespace:Paftax.Pafta.UI.Controls"
             xmlns:vm="clr-namespace:Paftax.Pafta.UI.ViewModels"
             xmlns:views="clr-namespace:Paftax.Pafta.UI.Views" 
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:RoomToSheetViewModel}"
             d:DesignHeight="700" 
             d:DesignWidth="900">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Paftax.Pafta.UI;component/Resources/Themes/Dark.xaml"/>
                <ResourceDictionary Source="/Paftax.Pafta.UI;component/Resources/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>
        
        <Border HorizontalAlignment="Stretch" Grid.Row="0" Height="1" VerticalAlignment="Top"/>

        <TabControl Grid.Row="0" Margin="10" >
            <TabItem Header="Creation">
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DataGrid x:Name="TemplateDataGrid" Margin="10" ItemsSource="{Binding ViewCreationTemplates}" AutoGenerateColumns="False" >
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Template Name" Binding="{Binding Name}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Column="1" Width="1" HorizontalAlignment="Left" Margin="-0.5,0,0,0"/>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DataGrid x:Name="ViewDataGrid" Grid.Row="1" Margin="10,0,10,10" ItemsSource="{Binding CreatedViews}" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="View Type" Binding="{Binding ViewType}" Width="100"/>
                                <DataGridTextColumn Header="View Name" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Title On Sheet" Binding="{Binding TitleOnSheet}" Width="*"/>
                                <DataGridTextColumn Header="Scale" Binding="{Binding Scale}" Width="60"/>
                                <DataGridTextColumn Header="View Template" Binding="{Binding ViewTemplate.Name}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Center">
                            <ComboBox Width="80" Height="30" Margin="0,0,10,0" IsEditable="True" Text="Add"/>
                            <Button Content="Remove" Width="80" Height="30" Margin="0,0,10,0" Command="{Binding RemoveViewCommand}"/>
                            <Button Content="Edit" Width="80" Height="30" Command="{Binding RemoveViewCommand}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Graphic Designer">
                <Grid>
                    <views:GraphicDesignerUserControl Grid.Column="1" x:Name="GraphicDesignerControl" Margin="10" DataContext="{Binding GraphicDesignerViewModel}"/>
                </Grid>
            </TabItem>

            <TabItem Header="Sheet Placement">
                <Grid>
                </Grid>
            </TabItem>
        </TabControl>
        
        <Border HorizontalAlignment="Stretch" Grid.Row="0" Height="1" VerticalAlignment="Bottom"/>
    </Grid>
</UserControl>
