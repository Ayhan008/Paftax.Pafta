<UserControl x:Class="Paftax.Pafta.UI.Views.GraphicDesignerUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Paftax.Pafta.UI.Views"
             xmlns:controls="clr-namespace:Paftax.Pafta.UI.Controls"
             xmlns:properties="clr-namespace:Paftax.Pafta.UI.AttachedProperties" properties:ThemeChanged.EnableTheme="True"
             xmlns:drawing="clr-namespace:Paftax.Pafta.Drawings;assembly=Paftax.Pafta.Drawings"
             xmlns:vm="clr-namespace:Paftax.Pafta.UI.ViewModels" d:DataContext="{d:DesignInstance Type=vm:GraphicDesignerViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Paftax.Pafta.UI;component/Resources/Themes/Dark.xaml"/>
                <ResourceDictionary Source="/Paftax.Pafta.UI;component/Resources/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource CanvasBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="CoordinatesTextBlock"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="5"
                   Panel.ZIndex="1"
                   Width="120"
                   Foreground="Black"
                   FontSize="12"
                   Text="{Binding MouseCoordinates}"/>

        <Grid Grid.Column="0" Grid.Row="0">
            <drawing:DrawingCanvas x:Name="Canvas"  
                                   Focusable="True"
                                   ClipToBounds="True"
                                   AnnotationScale="{Binding CanvasScale, Mode=TwoWay}"
                                   Background="{DynamicResource CanvasBackground}"/>
        </Grid>
        

        <ScrollBar Grid.Column="1" Width="18" 
                   Margin="0,0,0,-1"
                   Maximum="5000"
                   Minimum="-5000"
                   ViewportSize="{Binding Height, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Style="{StaticResource DrawingScrollBarVertical}"
                   Orientation="Vertical"/>


        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0" 
                      HorizontalAlignment="Stretch"
                      Height="18"
                      Margin="1,1,0,1"
                      Style="{StaticResource ScaleComboBoxStyle}" 
                      SelectedIndex="{Binding SelectedScaleIndex}" 
                      ItemsSource="{Binding Scales}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <ScrollBar Height="18" 
                       Grid.Column="1"
                       Margin="0,0,-1,0"
                       Maximum="5000"
                       Minimum="-5000"
                       ViewportSize="{Binding Width, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Orientation="Horizontal"
                       Style="{StaticResource DrawingScrollBarHorizontal}"/>
        </Grid>

        <Border Grid.Row="1" 
                Grid.Column="1"
                Margin="1"
                Background="{DynamicResource DrawingScrollBarBackground}"/>
    </Grid>
</UserControl>
