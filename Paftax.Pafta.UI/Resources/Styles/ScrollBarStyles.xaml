<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:Paftax.Pafta.UI.Converters">

    <!--Color Dictionary-->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Paftax.Pafta.UI;component/Resources/Themes/Dark.xaml"/>
        <ResourceDictionary Source="/Paftax.Pafta.UI;component/Resources/Styles/FontStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <converters:HorizontalVisibilityConverter x:Key="HorizontalVisibilityConverter"/>
    <converters:VerticalVisibilityConverter x:Key="VerticalVisibilityConverter"/>

    <!-- ScrollBar Styles-->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{DynamicResource ScrollBarBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ScrollBarBorderBrush}"/>
        <Setter Property="Width" Value="6"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="MinWidth" Value="6"/>
        <Setter Property="MinHeight" Value="100"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border x:Name="ScrollBar" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            HorizontalAlignment="Stretch" 
                            Background="{TemplateBinding Background}" 
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="2"/>
                            </Grid.RowDefinitions>

                            <Track x:Name="PART_Track" 
                                   Grid.Row="1" 
                                   IsDirectionReversed="True"
                                   Orientation="Vertical"
                                   VerticalAlignment="Stretch"
                                   HorizontalAlignment="Stretch"
                                   MinHeight="80">
                                <Track.Thumb>
                                    <Thumb x:Name="PART_Thumb">
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Background" Value="{DynamicResource ScrollBarThumbBackground}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource ScrollBarThumbBorderBrush}"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="VerticalAlignment" Value="Stretch"/>
                                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                                <Setter Property="Focusable" Value="False"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border x:Name="ThumbBorder" 
                                                                    Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    Width="6"
                                                                    CornerRadius="3"/>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True">
                                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ScrollBarThumbHoverBackground}"/>
                                                                    <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="{DynamicResource ScrollBarThumbHoverBorderBrush}"/>
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar" x:Key="DrawingScrollBar">
        <Setter Property="Background" Value="{DynamicResource DrawingScrollBarBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DrawingScrollBarBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DrawingScrollBarForeground}"/>
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <!-- Vertical ScrollBar -->
                            <Grid Visibility="{TemplateBinding Orientation, Converter={StaticResource VerticalVisibilityConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Up Button -->
                                <RepeatButton x:Name="LineUpButton"
                                              Grid.Row="0"
                                              Command="ScrollBar.LineUpCommand"
                                              Foreground="{TemplateBinding Foreground}"
                                              Height="{TemplateBinding Width}"
                                              Width="{TemplateBinding Width}"
                                              FontFamily="{StaticResource IconFont}"
                                              FontSize="13"
                                              Content="&#xe96d;"
                                              Background="{DynamicResource DrawingScrollBarBackground}" 
                                              BorderBrush="{DynamicResource DrawingScrollBarBorderBrush}"
                                              BorderThickness="0,0,0,1"/>

                                <!-- Track (with Thumb inside) -->
                                <Track x:Name="PART_Track"
                                       Grid.Row="1"
                                       Margin="0,2,0,2"
                                       Orientation="Vertical"  
                                       IsDirectionReversed="True"
                                       Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}}"
                                       Maximum="{TemplateBinding Maximum}"
                                       Minimum="{TemplateBinding Minimum}"
                                       ViewportSize="{TemplateBinding ViewportSize}">
                                    <Track.Thumb>
                                        <Thumb Background="{DynamicResource DrawingScrollBarThumbBackground}"
                                               BorderBrush="{DynamicResource DrawingScrollBarThumbBorderBrush}">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="ThumbBorder"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            Width="10"
                                                            CornerRadius="5" />
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>

                                <!-- Down Button -->
                                <RepeatButton x:Name="LineDownButton"
                                              Grid.Row="2"
                                              Command="ScrollBar.LineDownCommand"
                                              Foreground="{TemplateBinding Foreground}"
                                              Height="{TemplateBinding Width}"
                                              Width="{TemplateBinding Width}"
                                              FontFamily="{StaticResource IconFont}"
                                              FontSize="13"
                                              Content="&#xe96e;"
                                              Background="{DynamicResource DrawingScrollBarBackground}" 
                                              BorderBrush="{DynamicResource DrawingScrollBarBorderBrush}"
                                              BorderThickness="0,1,0,0"/>
                            </Grid>

                            <!-- Horizontal ScrollBar -->
                            <Grid Visibility="{TemplateBinding Orientation, Converter={StaticResource HorizontalVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Button -->
                                <RepeatButton x:Name="LineLeftButton"
                                              Grid.Column="0"
                                              Command="ScrollBar.LineLeftCommand"
                                              Foreground="{TemplateBinding Foreground}"
                                              Height="{TemplateBinding Height}"
                                              Width="{TemplateBinding Height}"
                                              FontFamily="{StaticResource IconFont}"
                                              FontSize="13"
                                              Content="&#xe96f;"
                                              Background="{DynamicResource DrawingScrollBarBackground}" 
                                              BorderBrush="{DynamicResource DrawingScrollBarBorderBrush}"
                                              BorderThickness="0,0,1,0"/>

                                <!-- Track -->
                                <Track x:Name="PART_Track_H"
                                       Grid.Column="1"
                                       Orientation="Horizontal"
                                       Margin="2,0,2,0"
                                       Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}}"
                                       Maximum="{TemplateBinding Maximum}"
                                       Minimum="{TemplateBinding Minimum}"
                                       ViewportSize="{TemplateBinding ViewportSize}">
                                    <Track.Thumb>
                                        <Thumb Background="{DynamicResource DrawingScrollBarThumbBackground}"
                                                BorderBrush="{DynamicResource DrawingScrollBarThumbBorderBrush}">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="ThumbBorder"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            Height="10"
                                                            CornerRadius="5"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>

                                <!-- Right Button -->
                                <RepeatButton x:Name="LineRightButton"
                                              Grid.Column="2"
                                              Command="ScrollBar.LineRightCommand"
                                              Foreground="{TemplateBinding Foreground}"
                                              Height="{TemplateBinding Height}"
                                              Width="{TemplateBinding Height}"
                                              FontFamily="{StaticResource IconFont}"
                                              FontSize="13"
                                              Content="&#xe970;"
                                              Background="{DynamicResource DrawingScrollBarBackground}" 
                                              BorderBrush="{DynamicResource DrawingScrollBarBorderBrush}"
                                              BorderThickness="1,0,0,0"/>
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>